// ██╔══██╗██╔═══██╗██╔════╝██║
// ██████╔╝██║   ██║█████╗  ██║
// ██╔══██╗██║   ██║██╔══╝  ██║
// ██║  ██║╚██████╔╝██║     ██║
// ╚═╝  ╚═╝ ╚═════╝ ╚═╝     ╚═╝
//
// ~~~~~~~~~~~~~~~~~~~~~~~~ ~/rofi/config.rasi ~~~~~~~~~~~~~~~~~~~~~~~~
*/
    /* ---- Configuration ---- */
    configuration {
    	modi:                       "recursivebrowser,drun,run,window,filebrowser";
        display-recursivebrowser:   "🌐 Global 🌐";
        display-drun:               "📦 App 📦";
        display-run:                "⚡ Run ⚡";
        display-window:             "🪟 Window 🪟";
        display-filebrowser:        "📁 Archiv 📁";
        terminal:                   "kitty";
        show-icons:                 true;
    	drun-display-format:        "{name}";
    	hover-select:               true;
    	me-select-entry:            "MouseSecondary";
        me-accept-entry:            "MousePrimary";
    	window-format:              "{w} · {c} · {t}";
    	dpi:						1;
        combi-display-format:       "{mode} {text}";
    }
    /* ---- Global Properties ---- */
    * {
        background:                  #000000;
        foreground:                  #FF0000;
        selected:                    #2CFF05;
        selected-text:               #2323FF;
        text-color:                  #c6e6f3;
    }
    /* ---- Recursive File Browser ---- */
    recursivebrowser {
        directory: "/home/tomaking";
        cancel-returns-1: true;
        filter-regex: "(.*cache.*|.*\\.git.*|.*node_modules.*)";
        command: "xdg-open";
    }
    /* ---- Window ---- */
    window {
        enabled:                    true;
        fullscreen:                 false;
        transparency:               "real";
        cursor:                     "default";
        spacing:                    0px;
        border:                     0px;
        border-radius:              11px;
        location:                   center;
        anchor:                     center;
        width:                      44%;
        background-image:           linear-gradient(to right, #FF0000, #FFFF00, #00FF00, #00FFFF, #0000FF, #FF00FF);
    }
    /* ----- Main Box ----- */
    mainbox {
        padding:			         5px;
        enabled:                     true;
        orientation:                 vertical;
        border:                      0px;
        border-radius:               11px;
        children:                    [ "inputbar", "mode-switcher", "listbox" ];
        background-color:            @background;
    }
    /* ---- Scrollbar ---- */
    scrollbar {
        width:                       4px;
        border:                      0;
        handle-color:                @selected;
        handle-width:                8px;
        padding:                     0;
        border-radius:               12px;
        background-color:            transparent;
    }
    /* ---- Inputbar ---- */
    inputbar {
        enabled:                     true;
        padding:                     0px 0px 0px 0px;
        margin:                      11px;
        background-color:            transparent;
        border-radius:               6px;
        orientation:                 horizontal;
        children:                    ["entry", "dummy" ];
    }
    /* ---- Entry input ---- */
    entry {
        font:                        "JetBrains Mono 12";
        enabled:                     true;
        expand:                      false;
        width:                       100%;
        padding:                     0px;
        border-radius:               1px;
        background-color:            @background;
        text-color:                  @selected;
        cursor:                      text;
        placeholder:                 "  ... 🔍 Search 🔍";
        placeholder-color:           inherit;
    }
    /* ---- Listbox ---- */
    listbox {
        spacing:                     0px;
        padding:                     0px;
        background-color:            transparent;
        orientation:                 vertical;
        children:                    [ "message", "listview" ];
    }
    /* ---- Listview ---- */
    listview {
        enabled:                     true;
        columns:                     1;
        lines:                       11;
        cycle:                       true;
        dynamic:                     true;
        scrollbar:                   true;
        layout:                      vertical;
        reverse:                     false;
        fixed-height:                false;
        fixed-columns:               true;    
        spacing:                     1px;
        background-color:            transparent;
        border:                      0px;
    }
    /* ---- Dummy ---- */
    dummy {
        expand:                      true;
        background-color:            transparent;
    }
    /* ---- Mode Switcher ---- */
    mode-switcher{
        enabled:                     true;
        spacing:                     11px;
        background-color:            transparent;
    }
    /* ---- Button ---- */
    button {
        width:                       5%;
        padding:                     0px;
        border-radius:               6px;
        background-color:            transparent;
        text-color:                  @text-color;
        cursor:                      pointer;
    }
    button selected {
        background-color:            @selected;
        text-color:                  @selected-text;
    }
    /* ---- Message ---- */
    message {
        background-color:            transparent;
        border:                      0px;
    }
    textbox {
        padding:                     11px;
        border-radius:               11px;
        border:                      1px;
        border-color:                @selected-text;
        background-color:            @background;
        text-color:                  @foreground;
        vertical-align:              0.5;
        horizontal-align:            0.0;
    }
    error-message {
        padding:                     33px;
        border-radius:               11px;
        background-color:            @background;
        text-color:                  @selected-text;
    }
    /* ---- Elements ---- */
    element {
        enabled:                     true;
        spacing:                     10px;
        padding:                     5px;
        border-radius:               5px;
        background-color:            transparent;
        cursor:                      pointer;
    }
    element normal.normal {
        background-color:            inherit;
        text-color:                  inherit;
    }
    element normal.urgent {
        background-color:            @selected;
        text-color:                  @foreground;
    }
    element normal.active {
        background-color:            @selected-text;
        text-color:                  @selected;
    }
    element selected.normal {
        background-color:            @selected;
        text-color:                  @selected-text;
    }
    element selected.urgent {
        background-color:            @selected;
        text-color:                  @selected-text;
    }
    element selected.active {
        background-color:            @selected;
        text-color:                  @selected-text;
    }
    element alternate.normal {
        background-color:            transparent;
        text-color:                  inherit;
    }
    element alternate.urgent {
        background-color:            transparent;
        text-color:                  inherit;
    }
    element alternate.active {
        background-color:            transparent;
        text-color:                  inherit;
    }
    element-icon {
        background-color:            transparent;
        text-color:                  inherit;
        size:                        20px;
        cursor:                      inherit;
    }
    element-text {
        background-color:            transparent;
        text-color:                  inherit;
        cursor:                      inherit;
        vertical-align:              0.5;
        horizontal-align:            0.0;
    }
/*
//
*/